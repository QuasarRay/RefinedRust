opam-version: "2.0"
synopsis: "SMTCoq integration for RefinedRust"
homepage: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
bug-reports: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
maintainer: "RefinedRust contributors"
authors: "RefinedRust contributors"
license: "BSD-3-Clause"

depends: [
  "refinedrust" {= version}
  # smtcoq and dependencies
  "rocq-metarocq-template" {(= "1.5.1+9.2")}
  "rocq-metarocq-common" {(= "1.5.1+9.2")}
  "rocq-metarocq-utils" {(= "1.5.1+9.2")}
  "rocq-sniper" {(= "dev")}
  "rocq-trakt" {(= "dev")}
  "rocq-smtcoq" {(= "dev")}
]

pin-depends: [
	["rocq-sniper.dev" "git+https://github.com/smtcoq/sniper.git#97d5296ec96fec2d40008dd9aca9a77ae08601e9"]
	["rocq-smtcoq.dev" "git+https://github.com/smtcoq/smtcoq#c0bd765e4283eef55a8f495706475305dc83c583"]
	["rocq-trakt.dev" "git+https://github.com/rocq-trakt/trakt#65a99129401c743baa54821a7a3b975e72b65e37"]
]

build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
