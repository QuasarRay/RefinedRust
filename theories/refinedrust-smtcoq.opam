opam-version: "2.0"
synopsis: "SMTCoq integration for RefinedRust"
homepage: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
bug-reports: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
maintainer: "RefinedRust contributors"
authors: "RefinedRust contributors"
license: "BSD-3-Clause"

depends: [
  "refinedrust" {= version}
  # smtcoq and dependencies
  "rocq-metarocq-template" {(= "1.5.1+9.2")}
  "rocq-metarocq-common" {(= "1.5.1+9.2")}
  "rocq-metarocq-utils" {(= "1.5.1+9.2")}
  "rocq-sniper" {(= "dev")}
  "rocq-trakt" {(= "dev")}
  "rocq-smtcoq" {(= "dev")}
]

pin-depends: [
	["rocq-sniper.dev" "git+https://github.com/smtcoq/sniper#795f00d79dbc835578d71eb7a81a6b3a006fafaf"]
	["rocq-smtcoq.dev" "git+https://github.com/smtcoq/smtcoq#42123026b4fb03fc3fc98cf5b889fa666d84810a"]
	["rocq-trakt.dev" "git+https://github.com/rocq-trakt/trakt#dcbfe6c85b3e39ae273f8f5a0fd2653366e76f53"]
]

build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
