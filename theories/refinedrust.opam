opam-version: "2.0"
name: "refinedrust"
synopsis: "RefinedRust verification framework"
homepage: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
bug-reports: "https://gitlab.mpi-sws.org/lgaeher/refinedrust-dev"
maintainer: "RefinedRust contributors"
authors: "RefinedRust contributors"
description: """
RefinedRust is a prototype framework for verifying safe and unsafe Rust code.
"""
license: "BSD-3-Clause"

depends: [
  "rocq-core" { (= "9.2.0" ) }
  "rocq-stdlib" { (= "9.1.0") }
  "rocq-stdpp"
  "rocq-stdpp-unstable"
  "rocq-stdpp-bitvector"
  "rocq-iris"
  "rocq-iris-contrib"
  "coq-lifetime-logic"
  "dune" {>= "3.23.1"}
  "rocq-equations" { (= "1.3.2+9.2") }
]

pin-depends: [
  ["rocq-stdpp.dev" "git+https://gitlab.mpi-sws.org/iris/stdpp.git#14c0bc58f09e5dc237b497f28853eb986935bfb1"]
  ["rocq-stdpp-unstable.dev" "git+https://gitlab.mpi-sws.org/iris/stdpp.git#14c0bc58f09e5dc237b497f28853eb986935bfb1"]
  ["rocq-stdpp-bitvector.dev" "git+https://gitlab.mpi-sws.org/iris/stdpp.git#14c0bc58f09e5dc237b497f28853eb986935bfb1"]
  ["rocq-iris.dev" "git+https://gitlab.mpi-sws.org/iris/iris.git#017e6f709b8ece9eaf2a3bf4cb554258a86dab8f"]
  ["rocq-iris-contrib.dev" "git+https://gitlab.mpi-sws.org/iris/iris-contrib.git#027bb25cff3a0a4dcab4f9013f6959383ad86014"]
  ["coq-lifetime-logic.dev" "git+https://gitlab.mpi-sws.org/iris/lambda-rust.git#fae056a5a19e59e9173016a72a3d32d63f656764"]
]

build: [
  ["dune" "subst"] {pinned}
  ["dune" "build" "-p" name "-j" jobs]
]
